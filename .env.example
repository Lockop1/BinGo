# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and anon (public) key: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by the cleanup cron route (/api/cron/cleanup).
# Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never import it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that protects /api/cron/cleanup (sent by Vercel Cron as a Bearer token).
CRON_SECRET=

# Public base URL used in invite links, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Optional product analytics (PostHog). Leave empty to turn analytics off entirely
# (posthog-js is then never loaded). No personal data is sent: no names, join codes,
# game/user ids, square text or URLs; see src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com (use https://eu.i.posthog.com for an EU project).
# Must be a different origin from the app (us/eu.i.posthog.com). Never proxy it through a
# same-origin path/rewrite: same-origin requests would carry the Supabase auth cookies.
NEXT_PUBLIC_POSTHOG_HOST=
